+            led->SetCompanionEffect(16, 0, 0, 0, 0);
+            break;
+        case COMPANION_LED_BLINK_SLOW:
+            led->SetCompanionEffect(0, 0, 4, 1000, -1);
+            break;
+        case COMPANION_LED_BLINK_FAST:
+            led->SetCompanionEffect(16, 0, 0, 200, -1);
+            break;
+        case COMPANION_LED_BLINK_ALARM:
