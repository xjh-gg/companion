+void GpioLed::SetCompanionEffect(uint8_t r, uint8_t g, uint8_t b,
+                                 int interval_ms, int times) {
+    (void)r;
+    (void)g;
+    (void)b;
+
+    if (!ledc_initialized_) {
+        return;
+    }
+    if (times != 0 && interval_ms <= 0) {
+        interval_ms = 100;
+    }
+
+    /* 单色红灯：用颜色分量中的最大值映射亮度（XiaoZhi 亮度等级 0–100） */
+    uint8_t level = r > g ? r : g;
+    if (b > level) {
+        level = b;
+    }
+    SetBrightness(level > 16 ? 100 : (level * 100 / 16));
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    esp_timer_stop(blink_timer_);
+    ledc_fade_stop(ledc_channel_.speed_mode, ledc_channel_.channel);
+
+    if (times == 0) {
+        ledc_set_duty(ledc_channel_.speed_mode, ledc_channel_.channel, duty_);
+        ledc_update_duty(ledc_channel_.speed_mode, ledc_channel_.channel);
+        return;
+    }
+
+    blink_counter_ = times * 2;
+    blink_interval_ms_ = interval_ms;
+    esp_timer_start_periodic(blink_timer_, interval_ms * 1000);
+}
