+typedef struct {
+    companion_state_t state;
+    uint32_t state_duration_ms;
+    uint32_t last_activity_age_ms;
+    uint32_t sleepy_timeout_min;
+    uint32_t sleepy_elapsed_sec;
+    uint32_t sleepy_remaining_sec;
+    event_t last_event;
+    uint32_t last_event_age_ms;
+} state_machine_snapshot_t;
+
+void state_machine_get_snapshot(state_machine_snapshot_t *out);
+
 #ifdef __cplusplus
 }
 #endif
