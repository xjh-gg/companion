+void state_machine_get_snapshot(state_machine_snapshot_t *out)
+{
+    if (!out) {
+        return;
+    }
+
+    uint32_t now = xTaskGetTickCount();
+    uint32_t state_tick;
+    uint32_t activity_tick;
+    uint32_t event_tick;
+
+    SM_LOCK();
+    out->state = s_state;
+    out->last_event = s_last_event;
+    out->sleepy_timeout_min = s_sleepy_timeout_min;
+    state_tick = s_state_enter_tick;
+    activity_tick = s_last_activity_tick;
+    event_tick = s_last_event_tick;
+    SM_UNLOCK();
+
+    out->state_duration_ms = (uint32_t)(now - state_tick) * portTICK_PERIOD_MS;
+    out->last_activity_age_ms = (uint32_t)(now - activity_tick) * portTICK_PERIOD_MS;
+    out->last_event_age_ms = (uint32_t)(now - event_tick) * portTICK_PERIOD_MS;
+
+    if (out->state == STATE_IDLE) {
+        out->sleepy_elapsed_sec = (uint32_t)(now - state_tick) * portTICK_PERIOD_MS / 1000;
+        uint32_t total = out->sleepy_timeout_min * 60;
+        out->sleepy_remaining_sec = (out->sleepy_elapsed_sec >= total)
+                                        ? 0
+                                        : (total - out->sleepy_elapsed_sec);
+    } else {
+        out->sleepy_elapsed_sec = 0;
+        out->sleepy_remaining_sec = 0;
+    }
 }
