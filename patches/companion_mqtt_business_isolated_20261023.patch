new file mode 100644
index 0000000..3d0dda2
--- /dev/null
+++ b/main/companion/companion_mqtt.cc
@@ -0,0 +1,462 @@
+#include "companion_mqtt.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+#include <cJSON.h>
+#include <esp_log.h>
+#include <esp_mac.h>
+#include <esp_timer.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/queue.h>
+#include <freertos/task.h>
+
+#include "companion_audio.h"
+#include "companion_mqtt_codec.h"
+#include "companion_mqtt_transport.h"
+#include "settings.h"
+#include "state_machine.h"
+#include "wifi_station.h"
+
+#define TAG "COMPANION_MQTT"
+
+#define OUT_QUEUE_LEN       16
+#define CMD_QUEUE_LEN       4
+#define OUT_TOPIC_MAX       96
+#define OUT_PAYLOAD_MAX     768
+#define CMD_ID_MAX          64
+#define SEEN_ID_COUNT       8
+
+struct OutMsg {
+    char topic[OUT_TOPIC_MAX];
+    char payload[OUT_PAYLOAD_MAX];
+};
+
+static QueueHandle_t s_out_queue = nullptr;
+static QueueHandle_t s_cmd_queue = nullptr;
+static TaskHandle_t s_task = nullptr;
+static std::atomic<bool> s_inited{false};
+static std::atomic<bool> s_client_started{false};
+static std::atomic<bool> s_connected{false};
+static std::atomic<bool> s_subscribe_pending{false};
+static std::atomic<bool> s_business_disabled{false};
+static std::atomic<uint32_t> s_sequence{0};
+static std::atomic<uint32_t> s_dropped{0};
+static std::atomic<uint32_t> s_last_publish_ms{0};
+static std::atomic<uint32_t> s_last_connect_ms{0};
+static std::atomic<uint32_t> s_connect_fail_streak{0};
+
+static std::string s_device_id;
+static std::string s_event_topic;
+static std::string s_status_topic;
+static std::string s_command_topic;
+static uint32_t s_status_period_ms = 10000;
+static uint32_t s_last_status_ms = 0;
+static uint32_t s_last_subscribe_attempt_ms = 0;
+static uint32_t s_last_client_start_attempt_ms = 0;
+
+static std::mutex s_seen_mutex;
+static char s_seen_ids[SEEN_ID_COUNT][CMD_ID_MAX + 1] = {};
+static size_t s_seen_next = 0;
+
+static const char *event_code(event_t evt)
+{
+    switch (evt) {
+        case EVT_KEY_PRESSED:    return "key";
+        case EVT_PICKED_UP:      return "pickup";
+        case EVT_SHAKE:          return "shake";
+        case EVT_HAND_NEAR:      return "hand_near";
+        case EVT_DARK:           return "dark";
+        case EVT_TIMER_SLEEPY:   return "timer_sleepy";
+        case EVT_ALARM:          return "alarm";
+        case EVT_INTERACT_START: return "interact_start";
+        case EVT_INTERACT_END:   return "interact_end";
+        case EVT_BRIGHT:         return "bright";
+        default:                 return "none";
+    }
+}
+
+static void enqueue_out(const char *topic, const char *payload)
+{
+    if (!s_inited.load() || s_business_disabled.load() ||
+        topic == nullptr || payload == nullptr) {
+        return;
+    }
+    if (strlen(payload) >= OUT_PAYLOAD_MAX) {
+        ESP_LOGW(TAG, "上报消息过长，丢弃: %u bytes", (unsigned)strlen(payload));
+        return;
+    }
+
+    OutMsg msg = {};
+    snprintf(msg.topic, sizeof(msg.topic), "%s", topic);
+    snprintf(msg.payload, sizeof(msg.payload), "%s", payload);
+
+    if (xQueueSend(s_out_queue, &msg, 0) != pdPASS) {
+        uint32_t drops = s_dropped.fetch_add(1) + 1;
+        if (drops == 1 || (drops % 20) == 0) {
+            ESP_LOGW(TAG, "MQTT 发送队列满，累计丢弃 %u", (unsigned)drops);
+        }
+    }
+}
+
+static void enqueue_json(const char *topic, cJSON *root)
+{
+    if (root == nullptr) {
+        return;
+    }
+    char *text = cJSON_PrintUnformatted(root);
+    cJSON_Delete(root);
+    if (text == nullptr) {
+        return;
+    }
+    enqueue_out(topic, text);
+    cJSON_free(text);
+}
+
+static void publish_status(uint32_t uptime_ms, const companion_mqtt_sensor_view_t *view)
+{
+    if (s_status_topic.empty()) {
+        return;
+    }
+
+    state_machine_snapshot_t snapshot = {};
+    state_machine_get_snapshot(&snapshot);
+
+    cJSON *root = cJSON_CreateObject();
+    if (root == nullptr) {
+        return;
+    }
+
+    cJSON_AddNumberToObject(root, "schema_version", 1);
+    cJSON_AddStringToObject(root, "device_id", s_device_id.c_str());
+    cJSON_AddStringToObject(root, "message_type", "status");
+    cJSON_AddNumberToObject(root, "timestamp", uptime_ms);
+    cJSON_AddStringToObject(root, "timestamp_type", "uptime_ms");
+    cJSON_AddNumberToObject(root, "sequence", s_sequence.fetch_add(1) + 1);
+    cJSON_AddStringToObject(root, "state", state_machine_state_name(snapshot.state));
+    cJSON_AddNumberToObject(root, "state_code", static_cast<int>(snapshot.state));
+
+    cJSON *sensors = cJSON_AddObjectToObject(root, "sensors");
+    if (sensors != nullptr) {
+        cJSON_AddNumberToObject(sensors, "als", view ? view->als : 0);
+        cJSON_AddNumberToObject(sensors, "ps", view ? view->ps : 0);
+        cJSON_AddNumberToObject(sensors, "gx", view ? view->gx : 0.0f);
+        cJSON_AddNumberToObject(sensors, "gy", view ? view->gy : 0.0f);
+        cJSON_AddNumberToObject(sensors, "gz", view ? view->gz : 0.0f);
+        cJSON_AddBoolToObject(sensors, "ap_ok", view ? view->ap_ok : false);
+        cJSON_AddBoolToObject(sensors, "qma_ok", view ? view->qma_ok : false);
+        cJSON_AddBoolToObject(sensors, "dark", view ? view->dark : false);
+    }
+
+    cJSON_AddStringToObject(root, "last_event",
+                            state_machine_event_name(snapshot.last_event));
+    cJSON_AddNumberToObject(root, "last_event_age_ms", snapshot.last_event_age_ms);
+    cJSON_AddNumberToObject(root, "sleepy_remaining_sec",
+                            snapshot.sleepy_remaining_sec);
+    cJSON_AddBoolToObject(root, "wifi_connected",
+                          WifiStation::GetInstance().IsConnected());
+    cJSON_AddBoolToObject(root, "mqtt_connected", s_connected.load());
+
+    enqueue_json(s_status_topic.c_str(), root);
+}
+
+static bool seen_command_id(const char *command_id)
+{
+    std::lock_guard<std::mutex> lock(s_seen_mutex);
+    for (size_t i = 0; i < SEEN_ID_COUNT; i++) {
+        if (s_seen_ids[i][0] != '\0' && strcmp(s_seen_ids[i], command_id) == 0) {
+            return true;
+        }
+    }
+    snprintf(s_seen_ids[s_seen_next], sizeof(s_seen_ids[s_seen_next]), "%s", command_id);
+    s_seen_next = (s_seen_next + 1) % SEEN_ID_COUNT;
+    return false;
+}
+
+static void process_commands(uint32_t uptime_ms,
+                             const companion_mqtt_sensor_view_t *view)
+{
+    if (s_cmd_queue == nullptr) {
+        return;
+    }
+
+    companion_mqtt_cmd_t cmd = {};
+    while (xQueueReceive(s_cmd_queue, &cmd, 0) == pdPASS) {
+        uint32_t age = uptime_ms - cmd.received_ms;
+        if (age > cmd.ttl_ms) {
+            ESP_LOGW(TAG, "命令已过期: id=%s age=%u ttl=%u",
+                     cmd.command_id, (unsigned)age, (unsigned)cmd.ttl_ms);
+            continue;
+        }
+
+        const char *result = "rejected";
+        if (strcmp(cmd.action, "request_status") == 0) {
+            publish_status(uptime_ms, view);
+            result = "accepted";
+        } else if (strcmp(cmd.action, "play_chime") == 0) {
+            result = companion_audio_request_reminder() ? "accepted" : "audio_busy";
+        } else if (strcmp(cmd.action, "noop") == 0) {
+            result = "accepted";
+        }
+
+        ESP_LOGI(TAG, "云端命令: id=%s intent=%s action=%s result=%s",
+                 cmd.command_id, cmd.intent, cmd.action, result);
+    }
+}
+
+static void mqtt_task(void *arg)
+{
+    (void)arg;
+    OutMsg msg = {};
+
+    while (true) {
+        if (s_business_disabled.load()) {
+            /* 熔断后必须丢弃本地已 Peek 的待发消息，否则重连会再次发送并触发 Broker 断开 */
+            xQueueReset(s_out_queue);
+            vTaskDelay(pdMS_TO_TICKS(1000));
+            continue;
+        }
+        if (xQueuePeek(s_out_queue, &msg, portMAX_DELAY) != pdPASS) {
+            continue;
+        }
+        if (!s_connected.load()) {
+            vTaskDelay(pdMS_TO_TICKS(500));
+            continue;
+        }
+        if (companion_mqtt_transport_publish(msg.topic, msg.payload, 1)) {
+            s_last_publish_ms.store(static_cast<uint32_t>(esp_timer_get_time() / 1000));
+            static uint32_t published = 0;
+            published++;
+            if (published == 1 || (published % 10) == 0) {
+                ESP_LOGI(TAG, "业务消息已交给 MQTT: %s (%u bytes, 累计 %u)",
+                         msg.topic, (unsigned)strlen(msg.payload), (unsigned)published);
+            }
+            xQueueReceive(s_out_queue, &msg, 0);
+            /* 重连后平滑补发，避免瞬间占满 broker/网络 */
+            vTaskDelay(pdMS_TO_TICKS(20));
+        } else {
+            ESP_LOGW(TAG, "业务消息发送失败，等待重试: %s", msg.topic);
+            vTaskDelay(pdMS_TO_TICKS(1000));
+        }
+    }
+}
+
+extern "C" void companion_mqtt_init(void)
+{
+    if (s_inited.load()) {
+        return;
+    }
+
+    Settings settings("mqtt", false);
+    s_device_id = settings.GetString("device_id");
+    if (s_device_id.empty()) {
+        s_device_id = settings.GetString("client_id");
+    }
+    if (s_device_id.empty()) {
+        uint8_t mac[6] = {};
+        if (esp_read_mac(mac, ESP_MAC_WIFI_STA) == ESP_OK) {
+            char fallback[32] = {};
+            snprintf(fallback, sizeof(fallback), "esp32s3-%02x%02x%02x",
+                     mac[3], mac[4], mac[5]);
+            s_device_id = fallback;
+        }
+    }
+    if (s_device_id.empty()) {
+        ESP_LOGW(TAG, "缺少 device_id/client_id，MQTT 业务上报禁用");
+        return;
+    }
+
+    s_event_topic = settings.GetString("companion_event_topic",
+                                       "companion/" + s_device_id + "/event");
+    s_status_topic = settings.GetString("companion_status_topic",
+                                        "companion/" + s_device_id + "/status");
+    s_command_topic = settings.GetString("companion_command_topic",
+                                         "companion/" + s_device_id + "/command");
+
+    int32_t period_s = settings.GetInt("companion_status_period_s", 10);
+    if (period_s < 5) {
+        period_s = 5;
+    } else if (period_s > 60) {
+        period_s = 60;
+    }
+    s_status_period_ms = static_cast<uint32_t>(period_s) * 1000;
+
+    /* 独立 MQTT 客户端必须等 lwIP/Wi-Fi 就绪后再启动，
+     * 否则会在网络栈未初始化时触发 tcpip_send_msg_wait_sem 断言。 */
+    s_out_queue = xQueueCreate(OUT_QUEUE_LEN, sizeof(OutMsg));
+    s_cmd_queue = xQueueCreate(CMD_QUEUE_LEN, sizeof(companion_mqtt_cmd_t));
+    if (s_out_queue == nullptr || s_cmd_queue == nullptr) {
+        ESP_LOGE(TAG, "创建 MQTT 业务队列失败");
+        return;
+    }
+    if (xTaskCreate(mqtt_task, "companion_mqtt", 4096, nullptr, 1, &s_task) != pdPASS) {
+        ESP_LOGE(TAG, "创建 MQTT 业务任务失败");
+        return;
+    }
+
+    s_inited.store(true);
+    ESP_LOGI(TAG, "业务上报就绪: device=%s event=%s status=%s command=%s period=%us",
+             s_device_id.c_str(), s_event_topic.c_str(), s_status_topic.c_str(),
+             s_command_topic.c_str(), (unsigned)period_s);
+}
+
+extern "C" void companion_mqtt_on_connected(void)
+{
+    s_connected.store(true);
+    s_last_connect_ms.store(static_cast<uint32_t>(esp_timer_get_time() / 1000));
+    if (s_business_disabled.load()) {
+        ESP_LOGW(TAG, "业务 MQTT 已禁用，仅保留小智语音连接");
+        return;
+    }
+    s_subscribe_pending.store(true);
+    ESP_LOGI(TAG, "MQTT 已连接，等待主任务订阅业务命令主题");
+}
+
+extern "C" void companion_mqtt_on_disconnected(void)
+{
+    s_connected.store(false);
+    s_subscribe_pending.store(false);
+    if (s_business_disabled.load()) {
+        return;
+    }
+
+    uint32_t now = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    uint32_t last_connect = s_last_connect_ms.load();
+    uint32_t last_publish = s_last_publish_ms.load();
+    bool near_connect = last_connect != 0 && (uint32_t)(now - last_connect) < 3000;
+    bool near_publish = last_publish != 0 && (uint32_t)(now - last_publish) < 3000;
+    if (!near_connect && !near_publish) {
+        return;
+    }
+
+    uint32_t streak = s_connect_fail_streak.fetch_add(1) + 1;
+    if (streak >= 2) {
+        s_business_disabled.store(true);
+        if (s_out_queue != nullptr) {
+            xQueueReset(s_out_queue);
+        }
+        if (s_cmd_queue != nullptr) {
+            xQueueReset(s_cmd_queue);
+        }
+        ESP_LOGE(TAG, "业务 MQTT 连续 %u 次连接/发布后被 Broker 断开，"
+                      "已禁用业务上报以保护小智语音连接", (unsigned)streak);
+    } else {
+        ESP_LOGW(TAG, "业务 MQTT 连接/发布后立即断开（%u/2），继续观察",
+                 (unsigned)streak);
+    }
+}
+
+extern "C" bool companion_mqtt_on_message(const char *topic, const char *payload)
+{
+    if (s_command_topic.empty() || topic == nullptr ||
+        s_command_topic != topic) {
+        return false;
+    }
+
+    companion_mqtt_cmd_t cmd = {};
+    char reason[48] = {};
+    uint32_t received_ms = static_cast<uint32_t>(esp_timer_get_time() / 1000);
+    if (!companion_mqtt_parse_command(payload, s_device_id.c_str(),
+                                      received_ms, &cmd,
+                                      reason, sizeof(reason))) {
+        ESP_LOGW(TAG, "命令校验失败: %s", reason);
+        return true;  /* 已识别为业务主题，但校验失败，禁止落入 XiaoZhi 解析 */
+    }
+    if (seen_command_id(cmd.command_id)) {
+        ESP_LOGW(TAG, "重复命令已忽略: id=%s", cmd.command_id);
+        return true;
+    }
+    if (xQueueSend(s_cmd_queue, &cmd, 0) != pdPASS) {
+        ESP_LOGW(TAG, "命令队列满，拒绝: id=%s", cmd.command_id);
+    }
+    return true;
+}
+
+extern "C" void companion_mqtt_publish_event(event_t evt, uint32_t uptime_ms,
+                                              const companion_mqtt_sensor_view_t *view)
+{
+    if (!s_inited.load() || s_event_topic.empty() || evt == EVT_NONE) {
+        return;
+    }
+
+    state_machine_snapshot_t snapshot = {};
+    state_machine_get_snapshot(&snapshot);
+
+    cJSON *root = cJSON_CreateObject();
+    if (root == nullptr) {
+        return;
+    }
+
+    cJSON_AddNumberToObject(root, "schema_version", 1);
+    cJSON_AddStringToObject(root, "device_id", s_device_id.c_str());
+    cJSON_AddStringToObject(root, "message_type", "event");
+    cJSON_AddStringToObject(root, "event_type", event_code(evt));
+    cJSON_AddNumberToObject(root, "timestamp", uptime_ms);
+    cJSON_AddStringToObject(root, "timestamp_type", "uptime_ms");
+    cJSON_AddNumberToObject(root, "sequence", s_sequence.fetch_add(1) + 1);
+
+    cJSON *data = cJSON_AddObjectToObject(root, "data");
+    if (data != nullptr) {
+        cJSON_AddStringToObject(data, "state",
+                                state_machine_state_name(snapshot.state));
+        cJSON_AddNumberToObject(data, "als", view ? view->als : 0);
+        cJSON_AddNumberToObject(data, "ps", view ? view->ps : 0);
+        cJSON_AddBoolToObject(data, "ap_ok", view ? view->ap_ok : false);
+        cJSON_AddBoolToObject(data, "qma_ok", view ? view->qma_ok : false);
+        cJSON_AddBoolToObject(data, "dark", view ? view->dark : false);
+    }
+
+    enqueue_json(s_event_topic.c_str(), root);
+}
+
+extern "C" void companion_mqtt_tick(uint32_t uptime_ms,
+                                     const companion_mqtt_sensor_view_t *view)
+{
+    if (!s_inited.load() || s_business_disabled.load()) {
+        return;
+    }
+
+    if (!s_client_started.load()) {
+        if (WifiStation::GetInstance().IsConnected() &&
+            (s_last_client_start_attempt_ms == 0 ||
+             (uint32_t)(uptime_ms - s_last_client_start_attempt_ms) >= 2000)) {
+            s_last_client_start_attempt_ms = uptime_ms;
+            if (companion_mqtt_client_start(s_command_topic.c_str())) {
+                s_client_started.store(true);
+                ESP_LOGI(TAG, "Wi-Fi 已就绪，独立业务 MQTT 已启动");
+            } else {
+                ESP_LOGW(TAG, "独立业务 MQTT 启动失败，2s 后重试");
+            }
+        }
+        return;
+    }
+
+    /* 订阅必须离开 MQTT 事件回调，避免在事件任务内重入 MQTT 客户端。
+     * 连接成功后由主任务每 2s 尝试一次，直到订阅成功。 */
+    if (s_connected.load() && s_subscribe_pending.load() &&
+        !s_command_topic.empty() &&
+        (s_last_subscribe_attempt_ms == 0 ||
+         (uint32_t)(uptime_ms - s_last_subscribe_attempt_ms) >= 2000)) {
+        s_last_subscribe_attempt_ms = uptime_ms;
+        if (companion_mqtt_transport_subscribe(s_command_topic.c_str(), 1)) {
+            s_subscribe_pending.store(false);
+            ESP_LOGI(TAG, "已订阅云端命令主题: %s", s_command_topic.c_str());
+        } else {
+            ESP_LOGW(TAG, "云端命令主题订阅失败，2s 后重试");
+        }
+    }
+
+    process_commands(uptime_ms, view);
+
+    if (s_status_topic.empty()) {
+        return;
+    }
+    if (s_last_status_ms == 0 ||
+        (uint32_t)(uptime_ms - s_last_status_ms) >= s_status_period_ms) {
+        s_last_status_ms = uptime_ms;
+        publish_status(uptime_ms, view);
+    }
+}
diff --git a/main/companion/companion_mqtt.h b/main/companion/companion_mqtt.h
new file mode 100644
index 0000000..005b828
--- /dev/null
+++ b/main/companion/companion_mqtt.h
@@ -0,0 +1,43 @@
+#ifndef COMPANION_MQTT_H
+#define COMPANION_MQTT_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "event_queue.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 由 companion_service 提供的传感器视图；无效数据保留最近值但 valid=false。 */
+typedef struct {
+    uint16_t als;
+    uint16_t ps;
+    float gx;
+    float gy;
+    float gz;
+    bool ap_ok;
+    bool qma_ok;
+    bool dark;
+} companion_mqtt_sensor_view_t;
+
+void companion_mqtt_init(void);
+
+/* MqttProtocol 连接生命周期回调 */
+void companion_mqtt_on_connected(void);
+void companion_mqtt_on_disconnected(void);
+/* 返回 true 表示该消息已被业务层处理，不再交给 XiaoZhi 协议解析。 */
+bool companion_mqtt_on_message(const char *topic, const char *payload);
+
+/* 主任务调用：事件即时入队；tick 负责低频状态与命令执行。 */
+void companion_mqtt_publish_event(event_t evt, uint32_t uptime_ms,
+                                  const companion_mqtt_sensor_view_t *view);
+void companion_mqtt_tick(uint32_t uptime_ms,
+                         const companion_mqtt_sensor_view_t *view);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* COMPANION_MQTT_H */
diff --git a/main/companion/companion_mqtt_client.cc b/main/companion/companion_mqtt_client.cc
new file mode 100644
index 0000000..bece6c4
--- /dev/null
+++ b/main/companion/companion_mqtt_client.cc
@@ -0,0 +1,151 @@
+#include "companion_mqtt_transport.h"
+
+#include "companion_mqtt.h"
+
+#include <cstdio>
+#include <cstring>
+
+#include <esp_log.h>
+#include <esp_mac.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <mqtt_client.h>
+
+#define TAG "COMPANION_BIZ_MQTT"
+
+#if __has_include("companion_mqtt_business_config.h")
+#include "companion_mqtt_business_config.h"
+#define COMPANION_BIZ_ENABLED 1
+#else
+#define COMPANION_BIZ_ENABLED 0
+#define COMPANION_BUSINESS_MQTT_ENDPOINT ""
+#define COMPANION_BUSINESS_MQTT_USERNAME ""
+#define COMPANION_BUSINESS_MQTT_PASSWORD ""
+#endif
+
+static esp_mqtt_client_handle_t s_client = nullptr;
+static volatile bool s_connected = false;
+static char s_command_topic[128] = {};
+
+static void mqtt_event_handler(void *arg, esp_event_base_t base,
+                               int32_t event_id, void *event_data)
+{
+    (void)arg;
+    (void)base;
+    auto *event = static_cast<esp_mqtt_event_handle_t>(event_data);
+
+    switch (event->event_id) {
+        case MQTT_EVENT_CONNECTED:
+            s_connected = true;
+            ESP_LOGI(TAG, "独立业务 MQTT 已连接");
+            companion_mqtt_on_connected();
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            s_connected = false;
+            ESP_LOGW(TAG, "独立业务 MQTT 已断开");
+            companion_mqtt_on_disconnected();
+            break;
+        case MQTT_EVENT_DATA: {
+            if (event->topic == nullptr || event->data == nullptr ||
+                s_command_topic[0] == '\0') {
+                break;
+            }
+            if (event->topic_len != (int)strlen(s_command_topic) ||
+                strncmp(event->topic, s_command_topic, event->topic_len) != 0) {
+                break;
+            }
+            char payload[1025] = {};
+            int len = event->data_len;
+            if (len > 1024) {
+                len = 1024;
+            }
+            memcpy(payload, event->data, len);
+            payload[len] = '\0';
+            companion_mqtt_on_message(s_command_topic, payload);
+            break;
+        }
+        case MQTT_EVENT_ERROR:
+            ESP_LOGW(TAG, "独立业务 MQTT 错误事件");
+            break;
+        default:
+            break;
+    }
+}
+
+extern "C" bool companion_mqtt_client_start(const char *command_topic)
+{
+#if !COMPANION_BIZ_ENABLED
+    (void)command_topic;
+    ESP_LOGW(TAG, "未提供 companion_mqtt_business_config.h，独立业务 MQTT 关闭");
+    return false;
+#else
+    if (s_client != nullptr) {
+        return true;
+    }
+    if (COMPANION_BUSINESS_MQTT_ENDPOINT[0] == '\0') {
+        ESP_LOGW(TAG, "业务 MQTT endpoint 为空");
+        return false;
+    }
+
+    snprintf(s_command_topic, sizeof(s_command_topic), "%s",
+             command_topic != nullptr ? command_topic : "");
+
+    esp_mqtt_client_config_t config = {};
+    config.broker.address.uri = COMPANION_BUSINESS_MQTT_ENDPOINT;
+    if (COMPANION_BUSINESS_MQTT_USERNAME[0] != '\0') {
+        config.credentials.username = COMPANION_BUSINESS_MQTT_USERNAME;
+        config.credentials.authentication.password = COMPANION_BUSINESS_MQTT_PASSWORD;
+    }
+    config.session.keepalive = 30;
+    config.session.last_will.topic = nullptr;
+
+    uint8_t mac[6] = {};
+    char client_id[32] = "companion-device";
+    if (esp_read_mac(mac, ESP_MAC_WIFI_STA) == ESP_OK) {
+        snprintf(client_id, sizeof(client_id), "companion-%02x%02x%02x",
+                 mac[3], mac[4], mac[5]);
+    }
+    config.credentials.client_id = client_id;
+
+    s_client = esp_mqtt_client_init(&config);
+    if (s_client == nullptr) {
+        ESP_LOGE(TAG, "创建独立业务 MQTT 客户端失败");
+        return false;
+    }
+    esp_mqtt_client_register_event(s_client, MQTT_EVENT_ANY,
+                                   mqtt_event_handler, nullptr);
+    if (esp_mqtt_client_start(s_client) != ESP_OK) {
+        ESP_LOGE(TAG, "启动独立业务 MQTT 客户端失败");
+        esp_mqtt_client_destroy(s_client);
+        s_client = nullptr;
+        return false;
+    }
+    ESP_LOGI(TAG, "独立业务 MQTT 客户端启动: %s", COMPANION_BUSINESS_MQTT_ENDPOINT);
+    return true;
+#endif
+}
+
+extern "C" bool companion_mqtt_transport_publish(const char *topic,
+                                                  const char *payload,
+                                                  int qos)
+{
+    if (s_client == nullptr || !s_connected || topic == nullptr || payload == nullptr) {
+        return false;
+    }
+    int msg_id = esp_mqtt_client_publish(s_client, topic, payload, 0, qos, 0);
+    return msg_id >= 0;
+}
+
+extern "C" bool companion_mqtt_transport_subscribe(const char *topic, int qos)
+{
+    if (s_client == nullptr || !s_connected || topic == nullptr) {
+        return false;
+    }
+    int msg_id = esp_mqtt_client_subscribe(s_client, topic, qos);
+    return msg_id >= 0;
+}
+
+extern "C" bool companion_mqtt_transport_is_connected(void)
+{
+    return s_client != nullptr && s_connected;
+}
diff --git a/main/companion/companion_mqtt_codec.c b/main/companion/companion_mqtt_codec.c
new file mode 100644
index 0000000..18222c8
--- /dev/null
+++ b/main/companion/companion_mqtt_codec.c
@@ -0,0 +1,101 @@
+#include "companion_mqtt_codec.h"
+
+#include <cJSON.h>
+#include <stdio.h>
+#include <string.h>
+
+#define CMD_MAX_TTL_S   300
+#define PAYLOAD_MAX_LEN 1024
+
+static void set_reason(char *reason, size_t cap, const char *text)
+{
+    if (reason != NULL && cap > 0) {
+        snprintf(reason, cap, "%s", text);
+    }
+}
+
+static bool get_string(const cJSON *root, const char *key,
+                       char *out, size_t cap, bool required)
+{
+    const cJSON *item = cJSON_GetObjectItem(root, key);
+    if (!cJSON_IsString(item) || item->valuestring == NULL) {
+        return !required;
+    }
+    snprintf(out, cap, "%s", item->valuestring);
+    return true;
+}
+
+bool companion_mqtt_parse_command(const char *payload, const char *device_id,
+                                  uint32_t received_ms,
+                                  companion_mqtt_cmd_t *out,
+                                  char *reason, size_t reason_cap)
+{
+    if (payload == NULL || out == NULL || device_id == NULL) {
+        set_reason(reason, reason_cap, "null");
+        return false;
+    }
+    if (strlen(payload) > PAYLOAD_MAX_LEN) {
+        set_reason(reason, reason_cap, "payload_too_large");
+        return false;
+    }
+
+    cJSON *root = cJSON_Parse(payload);
+    if (root == NULL) {
+        set_reason(reason, reason_cap, "invalid_json");
+        return false;
+    }
+
+    bool ok = false;
+    do {
+        const cJSON *version = cJSON_GetObjectItem(root, "schema_version");
+        if (!cJSON_IsNumber(version) || version->valueint != 1) {
+            set_reason(reason, reason_cap, "bad_schema_version");
+            break;
+        }
+
+        char dev[96] = {};
+        if (!get_string(root, "device_id", dev, sizeof(dev), true)) {
+            set_reason(reason, reason_cap, "missing_device_id");
+            break;
+        }
+        if (strcmp(dev, device_id) != 0) {
+            set_reason(reason, reason_cap, "device_mismatch");
+            break;
+        }
+
+        if (!get_string(root, "command_id", out->command_id,
+                        sizeof(out->command_id), true) ||
+            out->command_id[0] == '\0') {
+            set_reason(reason, reason_cap, "bad_command_id");
+            break;
+        }
+
+        const cJSON *ttl = cJSON_GetObjectItem(root, "ttl");
+        if (!cJSON_IsNumber(ttl) || ttl->valueint <= 0 ||
+            ttl->valueint > CMD_MAX_TTL_S) {
+            set_reason(reason, reason_cap, "bad_ttl");
+            break;
+        }
+        out->ttl_ms = (uint32_t)ttl->valueint * 1000;
+
+        if (!get_string(root, "action", out->action,
+                        sizeof(out->action), true)) {
+            set_reason(reason, reason_cap, "missing_action");
+            break;
+        }
+        if (strcmp(out->action, "request_status") != 0 &&
+            strcmp(out->action, "play_chime") != 0 &&
+            strcmp(out->action, "noop") != 0) {
+            set_reason(reason, reason_cap, "unsupported_action");
+            break;
+        }
+
+        get_string(root, "intent", out->intent, sizeof(out->intent), false);
+        get_string(root, "speech", out->speech, sizeof(out->speech), false);
+        out->received_ms = received_ms;
+        ok = true;
+    } while (0);
+
+    cJSON_Delete(root);
+    return ok;
+}
