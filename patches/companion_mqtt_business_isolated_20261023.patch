+extern "C" {
+#endif
+
+typedef struct {
+    char command_id[65];
+    char action[33];
+    char intent[33];
+    char speech[97];
+    uint32_t ttl_ms;
+    uint32_t received_ms;
+} companion_mqtt_cmd_t;
+
+/* 纯协议校验：不依赖 FreeRTOS/网络，便于主机测试。
+ * 返回 false 时 reason 给出简短原因。 */
+bool companion_mqtt_parse_command(const char *payload, const char *device_id,
+                                  uint32_t received_ms,
+                                  companion_mqtt_cmd_t *out,
+                                  char *reason, size_t reason_cap);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* COMPANION_MQTT_CODEC_H */
